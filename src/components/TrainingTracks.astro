---
// Training tracks as themed cards (home page). Each opens its part of
// /training/; the last card points anyone undecided to WhatsApp.
import { getCollection } from "astro:content";
import Icon from "./Icon.astro";
import TechLogos from "./TechLogos.astro";
import { whatsappFor } from "../lib/site";
import { href } from "../lib/url";

const tracks = (await getCollection("training")).sort((a, b) => a.data.order - b.data.order);
const themes = ["teal", "orange", "amber", "stone"] as const;
---
<ul class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
  {tracks.map((t, i) => (
    <li class={`theme-${themes[i % themes.length]}`} data-reveal style={`--reveal-delay:${(i % 3) * 80}ms`}>
      <article class="card-interactive relative flex h-full flex-col rounded-[1.5rem] bg-[var(--theme-bg)] p-6 text-[var(--theme-ink)] sm:p-8">
        <Icon name="arrow-up-right" size={20} class="corner-arrow" />
        <TechLogos logos={t.data.logos} />
        <h3 class="mt-6 text-h3">
          <a href={href(`/training/#${t.id}`)} class="after:absolute after:inset-0 after:rounded-[inherit] focus-visible:outline-none">{t.data.name}</a>
        </h3>
        <p class="mt-2 text-stone-700">{t.data.intro}</p>
        <ul class="mt-5 flex flex-wrap gap-2" aria-label={`${t.data.name} courses`}>
          {t.data.courses.map((c) => <li class="chip bg-white">{c.name}</li>)}
        </ul>
      </article>
    </li>
  ))}
  <li data-reveal style="--reveal-delay:160ms">
    <div class="on-dark flex h-full flex-col rounded-[1.5rem] bg-teal-950 p-6 text-white sm:p-8">
      <span class="logo-tile"><Icon name="whatsapp" size={28} class="brand-whatsapp" /></span>
      <h3 class="mt-6 text-h3">Not sure where to start?</h3>
      <p class="mt-2 text-teal-100">Tell us what you know today and where you want to get to. We'll suggest a course and share batch dates, timings and fees.</p>
      <div class="mt-auto pt-6">
        <a href={whatsappFor("Hi, I'd like help choosing a training course.")} rel="noopener" class="btn btn-whatsapp">
          <Icon name="whatsapp" size={20} class="brand-whatsapp" /> Ask on WhatsApp
        </a>
      </div>
    </div>
  </li>
</ul>
