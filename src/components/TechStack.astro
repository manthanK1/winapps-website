---
import { STACK } from "../lib/site";
---
<dl class="grid gap-x-10 gap-y-8 border-t border-line pt-10 sm:grid-cols-2 lg:grid-cols-4">
  {Object.entries(STACK).map(([group, items], i) => (
    <div data-reveal style={`--reveal-delay:${i * 70}ms`}>
      <dt class="text-xs font-semibold uppercase tracking-[0.08em] text-teal-700">{group}</dt>
      <dd class="mt-4">
        <ul class="flex flex-wrap gap-x-5 gap-y-2">
          {items.map((t) => <li class="font-display text-h4 font-medium tracking-tight text-ink">{t}</li>)}
        </ul>
      </dd>
    </div>
  ))}
</dl>
