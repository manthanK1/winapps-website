---
// Pre-footer call to action, centred on white just above the footer hills
// (CLAY-STYLE.md §5). Every page ends here, so every journey has a next step.
import Icon from "./Icon.astro";
import { SITE } from "../lib/site";
import { href } from "../lib/url";

interface Props {
  title?: string;
  text?: string;
}
const {
  title = "Tell us what you're building.",
  text = "A senior engineer, not a salesperson, replies within one business day. NDA available before any detailed discussion.",
} = Astro.props;
---
<section class="section defer-render pb-4 text-center sm:pb-6" aria-labelledby="cta-title">
  <div class="container-site" data-reveal>
    <h2 id="cta-title" class="mx-auto max-w-3xl text-h2 text-teal-950">{title}</h2>
    <p class="mx-auto mt-5 max-w-xl text-lead text-stone-700">{text}</p>
    <div class="mt-8 flex flex-col items-center justify-center gap-3 xs:flex-row">
      <a href={href("/contact/")} class="btn btn-dark">
        Book a 30-min intro call <Icon name="arrow-right" size={18} class="icon-arrow" />
      </a>
      <a href={`mailto:${SITE.email}`} class="btn btn-outline">Email us <Icon name="arrow-right" size={18} class="icon-arrow" /></a>
    </div>
    <p class="mt-4 text-sm text-muted">
      Or message us on <a class="link" href={SITE.whatsappHref} rel="noopener">WhatsApp</a>, or call <a class="link whitespace-nowrap" href={SITE.phoneHref}>{SITE.phone}</a>.
    </p>
  </div>
</section>
