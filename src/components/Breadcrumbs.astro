---
import { href } from "../lib/url";

interface Props {
  items: { name: string; path: string }[];
}
const { items } = Astro.props;
const trail = [{ name: "Home", path: "/" }, ...items];
---
<nav aria-label="Breadcrumb" class="text-sm">
  <ol class="flex flex-wrap items-center gap-x-2 gap-y-1 text-muted">
    {trail.map((item, i) => (
      <li class="flex items-center gap-2">
        {i > 0 && <span aria-hidden="true" class="text-stone-400">/</span>}
        {i === trail.length - 1
          ? <span aria-current="page" class="text-stone-800">{item.name}</span>
          : <a class="link" href={href(item.path)}>{item.name}</a>}
      </li>
    ))}
  </ol>
</nav>
