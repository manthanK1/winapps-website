---
// Discovery → Build → Launch & scale. Horizontal on desktop, vertical on mobile.
interface Props {
  detailed?: boolean;
}
const { detailed = false } = Astro.props;

const steps = [
  {
    title: "Discovery",
    time: "1–2 weeks · fixed fee",
    text: "We map the problem, the risks and the architecture, and give you a plan and estimate you can take to any vendor.",
    more: ["Problem and success criteria agreed in writing", "Architecture and risk review", "Plan and estimate you own, whoever builds it"],
  },
  {
    title: "Build",
    time: "2-week sprints",
    text: "Working software every sprint, demoed live in your time zone. Shared backlog, your tools, transparent burn against budget.",
    more: ["Live demo at the end of every sprint", "Code in your repositories from the first commit", "Spend tracked against budget, openly"],
  },
  {
    title: "Launch & scale",
    time: "Ongoing",
    text: "Production rollout, monitoring and SLAs. Then we keep evolving the product, or hand over cleanly to your team, with docs.",
    more: ["Production rollout with monitoring", "SLAs agreed up front", "Documented handover whenever you want it"],
  },
];
---
<ol class="timeline grid gap-10 lg:grid-cols-3 lg:gap-8">
  {steps.map((s, i) => (
    <li class="timeline-step relative pl-16 lg:pl-0 lg:pt-16" data-reveal style={`--reveal-delay:${i * 90}ms`}>
      <span class="timeline-dot" aria-hidden="true">{i + 1}</span>
      <p class="text-xs font-semibold uppercase tracking-[0.08em] text-teal-700">{s.time}</p>
      <h3 class="mt-2 text-h3 font-semibold tracking-tight text-teal-800">
        <span class="sr-only">Step {i + 1}: </span>{s.title}
      </h3>
      <p class="mt-3 max-w-sm text-stone-700">{s.text}</p>
      {detailed && (
        <ul class="mt-5 space-y-2 text-sm text-stone-700">
          {s.more.map((m) => <li class="flex gap-2"><span aria-hidden="true" class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-orange-500" />{m}</li>)}
        </ul>
      )}
    </li>
  ))}
</ol>

<style>
  .timeline-dot {
    position: absolute;
    left: 0;
    top: 0;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 999px;
    background: var(--color-white);
    border: 2px solid var(--color-teal-600);
    color: var(--color-teal-800);
    font-family: var(--font-display);
    font-weight: 600;
    z-index: 1;
  }
  /* Connecting ribbon line */
  .timeline-step:not(:last-child)::before {
    content: "";
    position: absolute;
    left: calc(1.375rem - 1px);
    top: 2.75rem;
    bottom: -2.5rem;
    width: 2px;
    background: linear-gradient(var(--color-teal-200), var(--color-teal-100));
  }
  @media (width >= 64rem) {
    .timeline-step:not(:last-child)::before {
      left: 3.25rem;
      right: -2rem;
      top: calc(1.375rem - 1px);
      bottom: auto;
      width: auto;
      height: 2px;
      background: linear-gradient(90deg, var(--color-teal-200), var(--color-teal-100));
      border-radius: 2px;
    }
  }
</style>
