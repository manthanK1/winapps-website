---
// Decorative ribbon curves echoing the logo's flowing "W". Abstract shapes,
// never the logo itself. Purely visual: hidden from assistive tech.
interface Props {
  variant: "hero" | "page" | "edge";
  class?: string;
}
const { variant, class: className = "" } = Astro.props;
const gid = `ribbon-grad-${variant}`;
---
{variant === "hero" && (
  <svg class={className} viewBox="0 0 600 640" fill="none" aria-hidden="true" focusable="false" preserveAspectRatio="xMaxYMid slice">
    <defs>
      <linearGradient id={gid} x1="600" y1="80" x2="120" y2="640" gradientUnits="userSpaceOnUse">
        <stop stop-color="#F39A2B" />
        <stop offset="1" stop-color="#F6C21E" />
      </linearGradient>
    </defs>
    <path d="M600 40C420 58 300 178 262 330C232 452 162 548 40 640H150C258 552 322 452 360 330C406 186 498 106 600 98Z" fill="var(--color-teal-100)" />
    <path d="M600 168C504 182 434 254 404 362C378 458 322 548 250 640H332C396 552 446 458 472 362C498 268 546 228 600 222Z" fill="var(--color-teal-50)" />
    <path d="M600 132C468 144 380 232 334 346C298 438 236 532 126 640" stroke={`url(#${gid})`} stroke-width="2.5" stroke-linecap="round" />
  </svg>
)}
{variant === "page" && (
  <svg class={className} viewBox="0 0 600 320" fill="none" aria-hidden="true" focusable="false" preserveAspectRatio="xMaxYMin slice">
    <path d="M600 0C470 20 380 92 340 180C312 242 266 290 196 320H286C344 286 388 238 416 180C454 104 520 54 600 44Z" fill="var(--color-teal-50)" />
    <path d="M600 70C510 82 450 130 420 196C400 240 366 284 320 320" stroke="var(--color-teal-100)" stroke-width="2" stroke-linecap="round" />
  </svg>
)}
{variant === "edge" && (
  <svg class={className} viewBox="0 0 1440 56" fill="none" aria-hidden="true" focusable="false" preserveAspectRatio="none">
    <path d="M0 56V40C320 40 520 0 760 0C1000 0 1180 28 1440 28V56Z" fill="currentColor" />
  </svg>
)}
