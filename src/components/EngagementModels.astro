---
import Icon from "./Icon.astro";
import { href } from "../lib/url";

// Dedicated Pod sits in the middle and is visually primary.
const models = [
  {
    name: "Fixed-scope project",
    fit: "Best for a well-defined product or MVP",
    points: ["Fixed price and timeline after Discovery", "Milestone-based payments", "30-day warranty after launch"],
    cta: "Discuss a project",
    featured: false,
  },
  {
    name: "Dedicated pod",
    fit: "Best for an evolving roadmap",
    points: ["3–8 engineers, a tech lead and QA", "Monthly rolling contract, 30 days' notice", "You approve every team member", "Monthly report on delivery and spend"],
    cta: "Build a pod",
    featured: true,
  },
  {
    name: "Team extension",
    fit: "Best for filling specific skills fast",
    points: ["Individual senior engineers", "Work inside your team and processes", "Start in as little as 2 weeks"],
    cta: "Extend your team",
    featured: false,
  },
];
---
<div class="grid items-stretch gap-6 lg:grid-cols-[1fr_1.2fr_1fr] lg:gap-5">
  {models.map((m, i) => (
    <article
      class:list={[
        "relative flex flex-col rounded-2xl p-7 sm:p-8",
        m.featured
          ? "on-dark order-first bg-teal-800 text-white shadow-[var(--shadow-lift)] lg:order-none lg:-my-4 lg:p-10"
          : "card",
      ]}
      data-reveal
      style={`--reveal-delay:${i * 90}ms`}
    >
      {m.featured && (
        <p class="absolute -top-3 left-7 rounded-full bg-orange-500 px-3 py-1 text-xs font-semibold text-ink sm:left-8 lg:left-10">Most chosen</p>
      )}
      <h3 class:list={["text-h3 font-semibold tracking-tight", m.featured ? "text-white" : "text-teal-800"]}>{m.name}</h3>
      <p class:list={["mt-2 text-sm", m.featured ? "text-teal-100" : "text-muted"]}>{m.fit}</p>
      <ul class="mt-6 flex-1 space-y-3 text-sm">
        {m.points.map((p) => (
          <li class="flex gap-3">
            <Icon name="check" size={18} class={`mt-0.5 shrink-0 ${m.featured ? "text-amber-300" : "text-teal-600"}`} />
            <span class={m.featured ? "text-white" : "text-stone-700"}>{p}</span>
          </li>
        ))}
      </ul>
      <a href={href("/contact/")} class:list={["btn mt-8 w-full", m.featured ? "btn-primary" : "btn-secondary"]}>
        {m.cta}
      </a>
      {m.featured && <p class="mt-3 text-center text-xs text-teal-100">Reply within 1 business day</p>}
    </article>
  ))}
</div>
