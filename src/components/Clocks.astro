---
// Live team-hours clocks. Client cities show a 09:00–18:00 workday; the
// Winapps row shows the shifted 11:00–20:00 IST day that creates the overlap.
// TODO: confirm delivery teams actually work 11:00–20:00 IST.
const zones = [
  { city: "New York", tz: "America/New_York", home: false },
  { city: "London", tz: "Europe/London", home: false },
  { city: "Berlin", tz: "Europe/Berlin", home: false },
  { city: "Winapps, India", tz: "Asia/Kolkata", home: true },
];
---
<div class="rounded-2xl border border-white/10 bg-white/[0.04] p-6 sm:p-8" data-clocks>
  <div class="flex items-center justify-between gap-4">
    <h3 class="font-display text-h4 font-semibold text-white">Working hours, live</h3>
    <p class="inline-flex items-center gap-2 text-xs font-semibold text-teal-100" data-clock-status>
      <span class="h-2 w-2 rounded-full bg-teal-300" aria-hidden="true"></span>
      <span>4+ hours overlap with Europe</span>
    </p>
  </div>
  <ul class="mt-6 divide-y divide-white/10 border-y border-white/10">
    {zones.map((z) => (
      <li class="grid grid-cols-[1fr_auto] items-center gap-x-4 gap-y-2 py-4" data-tz={z.tz} data-home={z.home ? "" : undefined}>
        <span class:list={["text-sm", z.home ? "font-semibold text-amber-300" : "text-teal-100"]}>{z.city}</span>
        <span class="text-h3 font-semibold tabular-nums tracking-tight text-white" data-time>--:--</span>
        <span class="relative col-span-2 h-1.5 rounded-full bg-white/10" aria-hidden="true">
          <span
            class:list={["absolute inset-y-0 rounded-full", z.home ? "bg-amber-400/80" : "bg-teal-400/70"]}
            style={z.home ? "left:45.83%;width:37.5%" : "left:37.5%;width:37.5%"}
          ></span>
          <span class="absolute -top-1 h-3.5 w-0.5 rounded-full bg-white" style="left:0" data-now hidden></span>
        </span>
      </li>
    ))}
  </ul>
  <p class="mt-5 text-sm text-teal-100">
    Bars show each city's working day. Our teams shift their hours to keep <strong class="font-semibold text-white">4+ hours of overlap</strong> with Central Europe and <strong class="font-semibold text-white">3–4 hours</strong> with US Eastern.
  </p>
</div>

<script>
  const root = document.querySelector<HTMLElement>("[data-clocks]");
  if (root) {
    const rows = [...root.querySelectorAll<HTMLElement>("[data-tz]")];
    const status = root.querySelector<HTMLElement>("[data-clock-status] span:last-child")!;

    const tick = () => {
      const now = new Date();
      let homeWorking = false;
      for (const row of rows) {
        const parts = new Intl.DateTimeFormat("en-GB", {
          timeZone: row.dataset.tz, hour: "2-digit", minute: "2-digit", weekday: "short", hourCycle: "h23",
        }).formatToParts(now);
        const get = (t: string) => parts.find((p) => p.type === t)?.value ?? "";
        const hours = Number(get("hour")) + Number(get("minute")) / 60;
        row.querySelector("[data-time]")!.textContent = `${get("hour")}:${get("minute")}`;
        const marker = row.querySelector<HTMLElement>("[data-now]")!;
        marker.hidden = false;
        marker.style.left = `${(hours / 24) * 100}%`;
        if (row.hasAttribute("data-home")) {
          homeWorking = !["Sat", "Sun"].includes(get("weekday")) && hours >= 11 && hours < 20;
        }
      }
      status.textContent = homeWorking ? "Team online now" : "Replies next business day";
    };
    tick();
    setInterval(tick, 30_000);
  }
</script>
