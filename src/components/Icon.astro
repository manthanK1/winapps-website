---
import { ICONS, type IconName } from "../lib/icons";

interface Props {
  name: IconName;
  class?: string;
  size?: number;
  label?: string;
}
const { name, class: className = "", size = 20, label } = Astro.props;

// Normalise every icon to the same stroke weight and strip the licence comment.
const a11y = label ? `role="img" aria-label="${label}"` : `aria-hidden="true"`;
const svg = ICONS[name]
  .replace(/<!--[\s\S]*?-->/, "")
  .replace(/class="[^"]*"/, `class="icon ${className}" ${a11y} focusable="false"`)
  .replace(/width="24"/, `width="${size}"`)
  .replace(/height="24"/, `height="${size}"`)
  .replace(/stroke-width="2"/, `stroke-width="1.75"`)
  .trim();
---
<Fragment set:html={svg} />
