---
import type { CollectionEntry } from "astro:content";
import { Picture } from "astro:assets";
import Icon from "./Icon.astro";
import { href } from "../lib/url";

interface Props {
  item: CollectionEntry<"work">;
  featured?: boolean;
  headingLevel?: "h2" | "h3";
}
const { item, featured = false, headingLevel: H = "h3" } = Astro.props;
const d = item.data;
---
<!-- Clay resource card: tinted fill, 24px radius, photo inset, no shadow. -->
<article class="card-tint card-interactive group flex h-full flex-col overflow-hidden p-2">
  <div class:list={["overflow-hidden rounded-[1.125rem] bg-teal-50", featured ? "aspect-[2/1]" : "aspect-[16/9]"]}>
    <Picture
      src={d.image}
      alt={d.imageAlt}
      formats={["avif", "webp"]}
      widths={[400, 640, 960]}
      sizes={featured ? "(min-width: 1024px) 800px, (min-width: 768px) 50vw, 100vw" : "(min-width: 1024px) 400px, (min-width: 768px) 50vw, 100vw"}
      class="h-full w-full object-cover transition-transform duration-700 ease-[var(--ease-quart)] group-hover:scale-[1.03]"
    />
  </div>
  <div class:list={["flex flex-1 flex-col p-4 sm:p-6", { "lg:px-8": featured }]}>
    <p class="eyebrow">
      {d.sector}{d.region && <> · {d.region}</>}
    </p>
    <H class:list={["mt-3 text-ink", featured ? "text-h3" : "text-h4"]}>
      <a href={href(`/work/${item.id}/`)} class="after:absolute after:inset-0 after:rounded-[inherit] focus-visible:outline-none">
        {d.title}
      </a>
    </H>
    <dl class="mt-5 space-y-4 text-sm">
      <div>
        <dt class="font-semibold text-stone-800">Problem</dt>
        <dd class="mt-1 text-stone-700">{d.problem}</dd>
      </div>
      <div>
        <dt class="font-semibold text-stone-800">What we delivered</dt>
        <dd class="mt-1 text-stone-700">{d.delivered}</dd>
      </div>
    </dl>
    <!-- TODO: client-approved outcome metric (results field in the case study file) -->
    <ul class="mt-6 flex flex-wrap gap-2" aria-label="Technology">
      {d.stack.map((t) => <li class="chip bg-white">{t}</li>)}
    </ul>
    <p class="line-link mt-auto pt-6 text-sm" aria-hidden="true">
      <span>Read the case study</span> <Icon name="arrow-right" size={16} />
    </p>
  </div>
</article>

<style>
  article:has(a:focus-visible) { outline: 3px solid var(--color-teal-600); outline-offset: 3px; }
  @media (prefers-reduced-motion: reduce) {
    article :global(img) { transition: none; transform: none !important; }
  }
</style>
