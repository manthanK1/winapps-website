---
// The six practices as stacked, themed panels (CLAY-STYLE.md §5 "Stacked
// feature panels"). On tall desktop viewports each panel sticks under the
// header and the next one slides over it; elsewhere they simply stack.
import { getCollection, getEntry } from "astro:content";
import Icon from "./Icon.astro";
import type { IconName } from "../lib/icons";
import { contactFor } from "../lib/site";
import { href } from "../lib/url";

const labels: Record<string, string> = {
  "ai-ml": "AI",
  "product-engineering": "Product",
  "cloud-platform": "Cloud",
  "legacy-modernization": "Modernize",
  "data-analytics": "Data",
  "dedicated-teams": "Teams",
};
const themes = ["teal", "orange", "amber", "stone"] as const;
const services = (await getCollection("services")).sort((a, b) => a.data.order - b.data.order);
const items = await Promise.all(
  services.map(async (s, i) => ({
    s,
    theme: themes[i % themes.length],
    related: s.data.relatedWork ? await getEntry(s.data.relatedWork) : undefined,
  }))
);
---
<div>
  {items.map(({ s, theme, related }, i) => (
    <div class:list={["practice-theme", `theme-${theme}`, { "is-last": i === items.length - 1 }]}>
      <article class="practice-item" aria-labelledby={`practice-${s.id}`}>
        <div class="flex flex-col">
          <p class="eyebrow-pill self-start">{labels[s.id] ?? s.data.title}</p>
          <h3 id={`practice-${s.id}`} class="mt-6 text-h2">
            {s.data.title}<br /> <span class="text-accent">{s.data.tagline}</span>
          </h3>
          <p class="mt-5 max-w-md text-stone-700">{s.data.summary}</p>
          <div class="mt-auto pt-8">
            {related && (
              <div class="flex items-center gap-3">
                <span class="badge-square shrink-0"><Icon name={s.data.icon as IconName} size={20} /></span>
                <p class="text-sm text-stone-700">
                  <strong class="font-semibold text-ink">Case study:</strong>{" "}
                  <a class="link" href={href(`/work/${related.id}/`)}>{related.data.title}</a>
                </p>
              </div>
            )}
            <div class="mt-6 flex flex-wrap gap-2">
              <a class="btn btn-theme" href={href(`/services/${s.id}/`)}>
                Explore {s.data.title}<span class="sr-only"> service</span> <Icon name="arrow-right" size={18} class="icon-arrow" />
              </a>
              <a class="btn btn-light" href={href(contactFor(s.id))}>Discuss a project<span class="sr-only"> in {s.data.title}</span></a>
            </div>
          </div>
        </div>

        <div class="practice-visual">
          <p class="eyebrow">What you get</p>
          <p class="mt-3 font-display text-h3 text-ink">{s.data.outcome}</p>
          <ul class="mt-6 grid gap-3">
            {s.data.deliverables.slice(0, 4).map((d) => (
              <li class="flex gap-3 text-sm text-stone-700">
                <Icon name="check" size={18} class="mt-0.5 shrink-0 text-[var(--theme-accent)]" />
                <span>{d}</span>
              </li>
            ))}
          </ul>
          <ul class="mt-6 flex flex-wrap gap-2 border-t border-stone-200 pt-6" aria-label={`Technology for ${s.data.title}`}>
            {s.data.tech.slice(0, 6).map((t) => <li class="chip">{t}</li>)}
          </ul>
        </div>
      </article>
    </div>
  ))}
</div>

<style>
  .practice-theme + .practice-theme { margin-top: 1rem; }
  .practice-item {
    display: grid;
    gap: 1.5rem;
    border-radius: var(--radius-panel);
    background: var(--theme-bg);
    color: var(--theme-ink);
    padding: clamp(1.5rem, 0.9rem + 2.6vw, 3rem);
  }
  .practice-visual {
    align-self: stretch;
    border-radius: 1.5rem;
    background: var(--color-white);
    padding: clamp(1.25rem, 0.8rem + 1.8vw, 2.5rem);
  }
  @media (width >= 64rem) {
    .practice-item { grid-template-columns: 1fr 1fr; gap: 3rem; }
  }
  /* Sticky stacking only where a whole panel fits in the viewport. */
  @media (width >= 64rem) and (height >= 46rem) {
    .practice-theme { position: sticky; top: 5rem; margin-bottom: -3rem; }
    .practice-theme + .practice-theme { margin-top: 0; }
    .practice-item { min-height: 36rem; padding-bottom: 6rem; border-radius: var(--radius-panel) var(--radius-panel) 0 0; }
    .practice-theme.is-last { margin-bottom: 0; }
    .is-last .practice-item { padding-bottom: 3rem; border-radius: var(--radius-panel); }
  }
</style>
