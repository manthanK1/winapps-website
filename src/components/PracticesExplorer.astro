---
// "What we do → What you get". Desktop: list on the left, outcome panel on the
// right. Mobile: the same markup reads as an accordion. Without JS every
// panel is shown.
import { getCollection } from "astro:content";
import Icon from "./Icon.astro";
import type { IconName } from "../lib/icons";
import { href } from "../lib/url";

const services = (await getCollection("services")).sort((a, b) => a.data.order - b.data.order);
---
<div class="practices" data-practices>
  {services.map((s, i) => (
    <>
      <h3 class="practice-heading" style={`--row:${i + 1}`}>
        <button
          type="button"
          id={`practice-btn-${s.id}`}
          class="practice-trigger group"
          aria-expanded={i === 0 ? "true" : "false"}
          aria-controls={`practice-panel-${s.id}`}
          data-practice-trigger
        >
          <span class="practice-icon"><Icon name={s.data.icon as IconName} size={22} /></span>
          <span class="min-w-0 flex-1">
            <span class="block font-display text-h4 font-semibold tracking-tight">{s.data.title}</span>
            <span class="practice-summary mt-1 block text-sm font-normal text-muted">{s.data.summary.split(". ")[0].replace(/[,.]$/, "")}.</span>
          </span>
          <Icon name="chevron-down" size={20} class="practice-chevron shrink-0 text-teal-700" />
        </button>
      </h3>
      <section
        id={`practice-panel-${s.id}`}
        aria-labelledby={`practice-btn-${s.id}`}
        class:list={["practice-panel", { "is-open": i === 0 }]}
      >
        <p class="text-xs font-semibold uppercase tracking-[0.08em] text-teal-700">What you get</p>
        <p class="mt-3 font-display text-h3 font-medium tracking-tight text-teal-900">{s.data.outcome}</p>
        <ul class="mt-6 grid gap-3 sm:grid-cols-2">
          {s.data.deliverables.slice(0, 4).map((d) => (
            <li class="flex gap-3 text-sm text-stone-700">
              <Icon name="check" size={18} class="mt-0.5 shrink-0 text-teal-600" />
              <span>{d}</span>
            </li>
          ))}
        </ul>
        <a href={href(`/services/${s.id}/`)} class="link mt-7 inline-flex min-h-11 items-center gap-1.5 font-semibold">
          Explore {s.data.title}<span class="sr-only"> service</span> <Icon name="arrow-right" size={18} />
        </a>
      </section>
    </>
  ))}
</div>

<style>
  .practices { border-top: 1px solid var(--color-line); }
  .practice-trigger {
    display: flex;
    width: 100%;
    align-items: flex-start;
    gap: 1rem;
    padding: 1.25rem 0.25rem;
    text-align: left;
    color: var(--color-ink);
    border-bottom: 1px solid var(--color-line);
    transition: color 0.2s, background-color 0.2s;
  }
  .practice-trigger:hover { color: var(--color-teal-800); }
  .practice-icon {
    display: grid;
    place-items: center;
    flex: none;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: var(--radius-md);
    background: var(--color-teal-50);
    color: var(--color-teal-700);
    transition: background-color 0.2s, color 0.2s;
  }
  .practice-trigger[aria-expanded="true"] { color: var(--color-teal-800); }
  .practice-trigger[aria-expanded="true"] .practice-icon { background: var(--color-teal-700); color: var(--color-white); }
  .practice-chevron { margin-top: 0.75rem; transition: transform 0.3s var(--ease-out); }
  .practice-trigger[aria-expanded="true"] .practice-chevron { transform: rotate(180deg); }
  .practice-panel { padding: 0.5rem 0.25rem 2rem 3.75rem; border-bottom: 1px solid var(--color-line); }
  :global(.js) .practice-panel:not(.is-open) { display: none; }
  :global(.js) .practice-trigger[aria-expanded="true"] { border-bottom-color: transparent; }

  @media (width >= 64rem) {
    .practices {
      display: grid;
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      column-gap: 3rem;
      border-top: 0;
    }
    .practice-heading { grid-column: 1; grid-row: var(--row); }
    .practice-trigger { padding: 1.125rem 1rem; border: 0; border-radius: var(--radius-md); }
    .practice-trigger:hover { background: var(--color-white); }
    .practice-trigger[aria-expanded="true"] { background: var(--color-white); box-shadow: var(--shadow-card); }
    .practice-chevron { transform: rotate(-90deg); }
    .practice-trigger[aria-expanded="true"] .practice-chevron { transform: rotate(-90deg) translateY(2px); }
    .practice-summary { display: none; }
    .practice-panel {
      grid-column: 2;
      grid-row: 1 / span 6;
      align-self: start;
      padding: 2.5rem;
      border: 1px solid var(--color-line);
      border-radius: var(--radius-xl);
      background: var(--color-white);
      box-shadow: var(--shadow-card);
    }
    :global(.js) .practice-panel.is-open { animation: panel-in 0.4s var(--ease-out); }
  }
  @keyframes panel-in { from { opacity: 0; transform: translateY(6px); } }
  @media (prefers-reduced-motion: reduce) {
    :global(.js) .practice-panel.is-open { animation: none; }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>("[data-practices]");
  if (root) {
    const triggers = [...root.querySelectorAll<HTMLButtonElement>("[data-practice-trigger]")];
    const desktop = matchMedia("(min-width: 64rem)");
    const panelOf = (t: HTMLButtonElement) => document.getElementById(t.getAttribute("aria-controls")!)!;

    function open(target: HTMLButtonElement) {
      for (const t of triggers) {
        const isTarget = t === target;
        t.setAttribute("aria-expanded", String(isTarget));
        panelOf(t).classList.toggle("is-open", isTarget);
      }
    }

    for (const t of triggers) {
      t.addEventListener("click", () => {
        const expanded = t.getAttribute("aria-expanded") === "true";
        if (expanded && !desktop.matches) {
          // Mobile accordion: allow collapsing the open item.
          t.setAttribute("aria-expanded", "false");
          panelOf(t).classList.remove("is-open");
        } else if (!expanded) {
          open(t);
        }
      });
      // Arrow keys move between practices (desktop list behaviour).
      t.addEventListener("keydown", (e) => {
        const i = triggers.indexOf(t);
        const next = e.key === "ArrowDown" ? triggers[i + 1] : e.key === "ArrowUp" ? triggers[i - 1] : null;
        if (next) { e.preventDefault(); next.focus(); }
      });
    }

    // Desktop always shows one panel.
    desktop.addEventListener("change", (e) => {
      if (e.matches && !triggers.some((t) => t.getAttribute("aria-expanded") === "true")) open(triggers[0]);
    });
  }
</script>
