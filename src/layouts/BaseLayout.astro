---
import "../styles/global.css";
import headingFont from "../assets/fonts/schibsted-grotesk-600.woff2?url";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE } from "../lib/site";
import { absolute, href } from "../lib/url";
import { breadcrumbs as breadcrumbSchema, organization } from "../lib/schema";

interface Props {
  title: string;
  description: string;
  /** Breadcrumb trail after Home, e.g. [{ name: "Work", path: "/work/" }] */
  breadcrumbs?: { name: string; path: string }[];
  jsonLd?: object[];
  noindex?: boolean;
  /** Let the first section run under the floating header (home hero). */
  underHeader?: boolean;
}

const { title, description, breadcrumbs, jsonLd = [], noindex = false, underHeader = false } = Astro.props;
const fullTitle = title === SITE.name ? `${SITE.name}® · ${SITE.tagline}` : `${title} · ${SITE.name}®`;
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const ogImage = absolute("/brand/og.png", Astro.site);
const logoImage = absolute("/brand/icon-512.png", Astro.site);

const schemas: object[] = [organization(Astro.site, logoImage), ...jsonLd];
if (breadcrumbs?.length) {
  schemas.push(breadcrumbSchema(Astro.site, [{ name: "Home", path: "/" }, ...breadcrumbs]));
}
const plausibleDomain = import.meta.env.PUBLIC_PLAUSIBLE_DOMAIN;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#FFFFFF" />

    <link rel="preload" href={headingFont} as="font" type="font/woff2" crossorigin />
    <script is:inline>document.documentElement.classList.add("js");</script>

    <link rel="icon" type="image/png" sizes="32x32" href={href("/favicon-32.png")} />
    <link rel="apple-touch-icon" href={href("/apple-touch-icon.png")} />
    <link rel="sitemap" href={href("/sitemap-index.xml")} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={`${SITE.name}®`} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Winapps logo: senior engineers for software that has to work." />
    <meta property="og:locale" content="en_GB" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {schemas.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}

    {plausibleDomain && <script is:inline defer data-domain={plausibleDomain} src="https://plausible.io/js/script.js" />}
  </head>
  <body>
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[60] focus:rounded-md focus:bg-ink focus:px-4 focus:py-3 focus:text-white">Skip to content</a>
    <Header />
    <main id="main" tabindex="-1" class:list={["outline-none", { "pt-16": !underHeader }]}>
      <slot />
    </main>
    <Footer />

    <script>
      // Scroll reveal: elements with [data-reveal] fade in once. CSS skips it
      // entirely under prefers-reduced-motion.
      const els = document.querySelectorAll<HTMLElement>("[data-reveal]");
      if ("IntersectionObserver" in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add("is-visible");
                io.unobserve(e.target);
              }
            }
          },
          { rootMargin: "0px 0px -8% 0px" }
        );
        els.forEach((el) => io.observe(el));
      } else {
        els.forEach((el) => el.classList.add("is-visible"));
      }
    </script>
  </body>
</html>
