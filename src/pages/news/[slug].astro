---
// News post. Slugs match the live site's /news/<slug> URLs.
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import Icon from "../../components/Icon.astro";
import CtaBand from "../../components/CtaBand.astro";
import { article } from "../../lib/schema";
import { href } from "../../lib/url";

export async function getStaticPaths() {
  const news = (await getCollection("news")).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
  return news.map((entry) => ({
    params: { slug: entry.id },
    props: { entry, more: news.filter((n) => n.id !== entry.id).slice(0, 4) },
  }));
}

const { entry, more } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
const path = `/news/${entry.id}/`;
const crumbs = [{ name: "News", path: "/news/" }, { name: d.title, path }];
---
<BaseLayout
  title={d.title}
  description={d.description}
  breadcrumbs={crumbs}
  jsonLd={[article(Astro.site, { type: "NewsArticle", headline: d.title, description: d.description, path, date: d.date })]}
>
  <PageHero breadcrumbs={crumbs} eyebrow={`News · ${d.dateLabel}`} title={d.title} theme="amber" />

  <section class="section" aria-label="News post">
    <div class="container-site grid gap-12 lg:grid-cols-12 lg:gap-10">
      <article class="prose-site text-lead text-stone-700 lg:col-span-7">
        <Content />
        <p><a href={href("/blog/")}>Read our in-depth guides</a> or <a href={href("/services/")}>see what we build</a>.</p>
      </article>
      <aside class="lg:col-span-4 lg:col-start-9" aria-labelledby="more-news-title">
        <div class="card-tint p-5">
          <h2 id="more-news-title" class="eyebrow">More news</h2>
          <ul class="mt-3 space-y-1">
            {more.map((n) => (
              <li>
                <a href={href(`/news/${n.id}/`)} class="group flex min-h-11 items-start justify-between gap-3 rounded-lg p-2 hover:bg-white">
                  <span>
                    <span class="block text-sm font-semibold text-ink">{n.data.title}</span>
                    <span class="block text-xs text-muted">{n.data.dateLabel}</span>
                  </span>
                  <Icon name="arrow-right" size={16} class="mt-1 shrink-0 text-stone-500 transition-transform group-hover:translate-x-0.5" />
                </a>
              </li>
            ))}
          </ul>
          <a href={href("/news/")} class="line-link ml-2 mt-2 text-sm"><span>All news</span> <Icon name="arrow-right" size={16} /></a>
        </div>
      </aside>
    </div>
  </section>

  <CtaBand />
</BaseLayout>
