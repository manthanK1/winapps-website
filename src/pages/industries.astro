---
import { getCollection, getEntries } from "astro:content";
import { Picture } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import Icon from "../components/Icon.astro";
import CtaBand from "../components/CtaBand.astro";
import type { IconName } from "../lib/icons";
import { href } from "../lib/url";

const industries = await Promise.all(
  (await getCollection("industries"))
    .sort((a, b) => a.data.order - b.data.order)
    .map(async (i) => ({ ...i.data, id: i.id, work: await getEntries(i.data.relatedWork) }))
);
const crumbs = [{ name: "Industries", path: "/industries/" }];
---
<BaseLayout
  title="Industries"
  description="Software engineering for healthcare, fintech, manufacturing, logistics, retail, media, education and travel companies in India, the US, the UK and Europe."
  breadcrumbs={crumbs}
>
  <PageHero
    breadcrumbs={crumbs}
    eyebrow="Industries"
    title="Domains"
    accent="we know well."
    lead="Every industry brings its own constraints: regulation, uptime, data sensitivity, peak load. We bring engineers who have worked within them."
  />

  <section class="section" aria-label="Industries we serve">
    <div class="container-site">
      <ul class="grid gap-4 md:grid-cols-2">
        {industries.map((ind, i) => (
          <li class="card-tint flex flex-col p-2" id={ind.id} data-reveal style={`--reveal-delay:${(i % 2) * 70}ms`}>
            <Picture
              src={ind.image}
              alt={ind.imageAlt}
              formats={["avif", "webp"]}
              widths={[400, 640, 960]}
              sizes="(min-width: 1280px) 590px, (min-width: 768px) 46vw, 100vw"
              class="aspect-[16/9] w-full rounded-[1.125rem] bg-teal-50 object-cover"
            />
            <div class="flex flex-1 items-start gap-5 p-4 sm:p-6">
              <span class="grid h-12 w-12 shrink-0 place-items-center rounded-[0.875rem] bg-white text-teal-700"><Icon name={ind.icon as IconName} size={24} /></span>
              <div class="flex min-h-full min-w-0 flex-1 flex-col">
                <h2 class="text-h3 text-teal-950">{ind.name}</h2>
                <p class="mt-3 text-stone-700">{ind.summary}</p>
                <ul class="mt-5 flex flex-wrap gap-2" aria-label={`Focus areas in ${ind.name}`}>
                  {ind.focus.map((f) => <li class="chip bg-white">{f}</li>)}
                </ul>
                <div class="mt-auto flex flex-col pt-5">
                  {ind.work.map((w) => (
                    <a href={href(`/work/${w.id}/`)} class="link inline-flex min-h-11 items-center gap-1.5 text-sm font-semibold">
                      Case study: {w.data.title} <Icon name="arrow-right" size={16} />
                    </a>
                  ))}
                  <a href={href("/contact/")} class="line-link text-sm"><span>Discuss a {ind.name.toLowerCase()} project</span> <Icon name="arrow-right" size={16} /></a>
                </div>
              </div>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <CtaBand title="Working in a regulated or high-stakes domain?" />
</BaseLayout>
