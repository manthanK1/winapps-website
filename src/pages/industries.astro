---
import { getCollection, getEntries } from "astro:content";
import { Picture } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import Icon from "../components/Icon.astro";
import CtaBand from "../components/CtaBand.astro";
import type { IconName } from "../lib/icons";
import { href } from "../lib/url";

const industries = await Promise.all(
  (await getCollection("industries"))
    .sort((a, b) => a.data.order - b.data.order)
    .map(async (i) => ({ ...i.data, id: i.id, work: await getEntries(i.data.relatedWork) }))
);
const crumbs = [{ name: "Industries", path: "/industries/" }];
---
<BaseLayout
  title="Industries"
  description="Software engineering for healthcare, fintech, manufacturing, logistics, retail, media, education and travel companies in India, the US, the UK and Europe."
  breadcrumbs={crumbs}
>
  <PageHero
    breadcrumbs={crumbs}
    eyebrow="Industries"
    title="Domains we know well."
    lead="Every industry brings its own constraints: regulation, uptime, data sensitivity, peak load. We bring engineers who have worked within them."
  />

  <section class="section bg-white" aria-label="Industries we serve">
    <div class="container-site">
      <ul class="grid gap-x-10 gap-y-0 md:grid-cols-2">
        {industries.map((ind, i) => (
          <li class="border-t border-line py-10" id={ind.id} data-reveal style={`--reveal-delay:${(i % 2) * 70}ms`}>
            <Picture
              src={ind.image}
              alt={ind.imageAlt}
              formats={["avif", "webp"]}
              widths={[400, 640, 960]}
              sizes="(min-width: 1280px) 590px, (min-width: 768px) 46vw, 100vw"
              class="mb-8 aspect-[16/9] w-full rounded-2xl bg-teal-50 object-cover"
            />
            <div class="flex items-start gap-5">
              <span class="grid h-12 w-12 shrink-0 place-items-center rounded-xl bg-teal-50 text-teal-700"><Icon name={ind.icon as IconName} size={24} /></span>
              <div class="min-w-0">
                <h2 class="text-h3 font-semibold tracking-tight text-teal-800">{ind.name}</h2>
                <p class="mt-3 text-stone-700">{ind.summary}</p>
                <ul class="mt-5 flex flex-wrap gap-2" aria-label={`Focus areas in ${ind.name}`}>
                  {ind.focus.map((f) => <li class="chip">{f}</li>)}
                </ul>
                {ind.work.map((w) => (
                  <a href={href(`/work/${w.id}/`)} class="link mt-5 inline-flex min-h-11 items-center gap-1.5 text-sm font-semibold">
                    Case study: {w.data.title} <Icon name="arrow-right" size={16} />
                  </a>
                ))}
              </div>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <CtaBand edgeClass="text-white" title="Working in a regulated or high-stakes domain?" />
</BaseLayout>
