---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import Ribbon from "../components/Ribbon.astro";
import SectionHeader from "../components/SectionHeader.astro";
import PracticesExplorer from "../components/PracticesExplorer.astro";
import CaseCard from "../components/CaseCard.astro";
import ProcessTimeline from "../components/ProcessTimeline.astro";
import TrustSection from "../components/TrustSection.astro";
import EngagementModels from "../components/EngagementModels.astro";
import TechStack from "../components/TechStack.astro";
import FaqList from "../components/FaqList.astro";
import CtaBand from "../components/CtaBand.astro";
import { PROMISES, SITE } from "../lib/site";
import { href } from "../lib/url";
import { faqPage } from "../lib/schema";

const work = (await getCollection("work")).sort((a, b) => a.data.order - b.data.order);
const faq = (await getCollection("faq")).sort((a, b) => a.data.order - b.data.order).map((f) => f.data);
const clients = await getCollection("clients");
const testimonials = await getCollection("testimonials");
---
<BaseLayout
  title={SITE.name}
  description="Senior engineers for software that has to work. Winapps builds AI, web and mobile products, cloud platforms and modernization for companies in India, the US, the UK and Europe. Est. 2013."
  jsonLd={[faqPage(faq)]}
>
  <!-- 2. Hero -->
  <section class="relative overflow-hidden bg-paper" aria-labelledby="hero-title">
    <Ribbon variant="hero" class="pointer-events-none absolute right-0 top-0 hidden h-full w-[40%] lg:block xl:w-[44%]" />
    <div class="container-site relative pb-14 pt-14 sm:pt-20 lg:pb-20 lg:pt-28">
      <div class="max-w-4xl lg:max-w-[60%]">
        <p class="eyebrow">Software engineering partner since {SITE.founded}</p>
        <h1 id="hero-title" class="mt-5 text-display font-semibold tracking-[-0.035em] text-teal-800">
          Senior engineers for software that <span class="text-ink">has to work.</span>
        </h1>
        <p class="mt-7 max-w-2xl text-lead text-stone-700">
          We design, build and scale AI systems, web and mobile products and cloud platforms for companies in India, the US, the UK and Europe, as an extension of your team.
        </p>
        <div class="mt-9 flex flex-col gap-3 xs:flex-row xs:flex-wrap xs:items-center">
          <a href={href("/contact/")} class="btn btn-primary">
            Book a 30-min intro call <Icon name="arrow-right" size={18} class="icon-arrow" />
          </a>
          <a href={href("/work/")} class="btn btn-secondary">See our work</a>
        </div>
      </div>

      <ul class="mt-14 grid grid-cols-2 gap-px overflow-hidden rounded-xl border border-line bg-line lg:mt-20 lg:grid-cols-4" aria-label="Our commitments">
        {PROMISES.map((p) => (
          <li class="flex items-center gap-3 bg-paper px-4 py-4 text-sm font-semibold text-stone-800 sm:px-5">
            <Icon name={p.icon} size={20} class="shrink-0 text-teal-600" />
            <span>{p.label}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 3. Client logos: hidden until real logos with written permission exist (src/content/clients). -->
  {clients.length > 0 && (
    <section class="border-y border-line bg-white" aria-label="Clients">
      <div class="container-site flex flex-wrap items-center justify-center gap-x-12 gap-y-6 py-10">
        {clients.map((c) => <Image src={c.data.logo} alt={c.data.name} height={36} class="h-9 w-auto opacity-80 grayscale" />)}
      </div>
    </section>
  )}

  <!-- 4. What we do → what you get -->
  <section class="section bg-white" aria-labelledby="practices-title">
    <div class="container-site">
      <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
        <SectionHeader
          id="practices-title"
          eyebrow="What we do → what you get"
          title="Six practices. One standard of engineering."
          class="lg:col-span-7"
        />
        <p class="text-stone-700 lg:col-span-4 lg:col-start-9" data-reveal>
          We stay narrow on purpose. Each practice is run by people who have shipped it in production, more than once.
        </p>
      </div>
      <div class="mt-12 lg:mt-16">
        <PracticesExplorer />
      </div>
    </div>
  </section>

  <!-- 5. Selected work -->
  <section class="section bg-paper" aria-labelledby="work-title">
    <div class="container-site">
      <div class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
        <SectionHeader
          id="work-title"
          eyebrow="Selected work"
          title="Problems we've been trusted with."
          intro="Our clients are under NDA, so we describe the work without naming them. We share specifics and references on a call."
        />
        <a href={href("/work/")} class="link inline-flex min-h-11 shrink-0 items-center gap-1.5 font-semibold" data-reveal>
          All case studies <Icon name="arrow-right" size={18} />
        </a>
      </div>
      <ul class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {work.map((item, i) => (
          <li class:list={[{ "lg:col-span-2": i === 0 || i === 3 }]} data-reveal style={`--reveal-delay:${(i % 2) * 80}ms`}>
            <CaseCard item={item} featured={i === 0 || i === 3} />
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 6. How we work -->
  <section class="section bg-white" aria-labelledby="process-title">
    <div class="container-site">
      <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
        <SectionHeader id="process-title" eyebrow="How we work" title="Low-risk to start. Predictable to scale." class="lg:col-span-7" />
        <p class="text-stone-700 lg:col-span-4 lg:col-start-9" data-reveal>
          Most clients start with a fixed-fee Discovery, then move to a dedicated pod.{" "}
          <a href={href("/how-we-work/")} class="link font-semibold">How we work in detail</a>
        </p>
      </div>
      <div class="mt-14 lg:mt-20"><ProcessTimeline /></div>
    </div>
  </section>

  <!-- 7. Why trust us -->
  <TrustSection edgeClass="text-white" />

  <!-- 8. Engagement models -->
  <section class="section bg-paper" aria-labelledby="engage-title">
    <div class="container-site">
      <SectionHeader
        id="engage-title"
        eyebrow="Engagement models"
        title="Pick how we work together."
        intro="Clear terms, no lock-in. Every model starts with the same senior engineers and the same commitments."
      />
      <div class="mt-14 lg:mt-20"><EngagementModels /></div>
    </div>
  </section>

  <!-- 9. Testimonials: hidden until real, approved quotes exist (src/content/testimonials). -->
  {testimonials.length > 0 && (
    <section class="section bg-white" aria-labelledby="testimonials-title">
      <div class="container-site">
        <SectionHeader id="testimonials-title" eyebrow="Clients" title="In their words." />
        <ul class="mt-12 grid gap-6 md:grid-cols-2">
          {testimonials.map((t) => (
            <li>
              <figure class="card h-full p-8">
                <blockquote class="font-display text-h4 font-medium text-ink">“{t.data.quote}”</blockquote>
                <figcaption class="mt-6 text-sm text-muted"><strong class="text-ink">{t.data.name}</strong>, {t.data.role}, {t.data.company}</figcaption>
              </figure>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <!-- 10. Tech stack -->
  <section class="section-tight bg-white" aria-labelledby="stack-title">
    <div class="container-site">
      <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
        <SectionHeader id="stack-title" eyebrow="Technology" title="Tools we use in production." class="lg:col-span-7" />
        <p class="text-stone-700 lg:col-span-4 lg:col-start-9" data-reveal>Languages, frameworks and platforms our engineers work with in production.</p>
      </div>
      <div class="mt-10"><TechStack /></div>
    </div>
  </section>

  <!-- 11. FAQ -->
  <section class="section bg-paper" aria-labelledby="faq-title">
    <div class="container-site grid gap-10 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <SectionHeader id="faq-title" eyebrow="Questions" title="What buyers usually ask." class="lg:sticky lg:top-28">
          <p class="mt-5 text-stone-700">Something else? <a class="link" href={`mailto:${SITE.email}`}>{SITE.email}</a></p>
        </SectionHeader>
      </div>
      <div class="lg:col-span-7 lg:col-start-6" data-reveal>
        <FaqList items={faq} />
      </div>
    </div>
  </section>

  <!-- 12. Final CTA -->
  <CtaBand edgeClass="text-paper" />
</BaseLayout>
