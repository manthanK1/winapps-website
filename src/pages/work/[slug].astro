---
// Case study: Challenge → Approach → Architecture → Results → Stack → CTA.
import { getCollection, getEntries, render } from "astro:content";
import { Picture } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import ArchitectureDiagram from "../../components/ArchitectureDiagram.astro";
import Icon from "../../components/Icon.astro";
import CtaBand from "../../components/CtaBand.astro";
import { href } from "../../lib/url";

export async function getStaticPaths() {
  const work = (await getCollection("work")).sort((a, b) => a.data.order - b.data.order);
  return work.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, next: work[(i + 1) % work.length] },
  }));
}

const { entry, next } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
const services = await getEntries(d.services);
const path = `/work/${entry.id}/`;
const crumbs = [{ name: "Work", path: "/work/" }, { name: d.title, path }];
---
<BaseLayout title={d.title} description={d.seoDescription} breadcrumbs={crumbs}>
  <PageHero breadcrumbs={crumbs} eyebrow={`${d.sector}${d.region ? ` · ${d.region}` : ""}`} title={d.title} lead={d.delivered} />

  <section class="section" aria-label="Case study">
    <div class="container-site grid gap-12 lg:grid-cols-12 lg:gap-10">
      <aside class="lg:col-span-4 lg:order-2 lg:col-start-9">
        <dl class="card-tint divide-y divide-stone-300 p-6 text-sm lg:sticky lg:top-28">
          <div class="pb-4">
            <dt class="font-semibold text-stone-800">Sector</dt>
            <dd class="mt-1 text-stone-700">{d.sector}</dd>
          </div>
          {d.region && (
            <div class="py-4">
              <dt class="font-semibold text-stone-800">Region</dt>
              <dd class="mt-1 text-stone-700">{d.region}</dd>
            </div>
          )}
          <div class="py-4">
            <dt class="font-semibold text-stone-800">Disciplines</dt>
            <dd class="mt-1 text-stone-700">{d.disciplines.join(" · ")}</dd>
          </div>
          {services.length > 0 && (
            <div class="py-4">
              <dt class="font-semibold text-stone-800">Practices</dt>
              <dd class="mt-1">
                <ul>
                  {services.map((s) => <li><a class="link inline-flex min-h-9 items-center" href={href(`/services/${s.id}/`)}>{s.data.title}</a></li>)}
                </ul>
              </dd>
            </div>
          )}
          <div class="pt-4">
            <dt class="font-semibold text-stone-800">Client</dt>
            <dd class="mt-1 text-stone-700">Under NDA. References available on a call.</dd>
          </div>
        </dl>
      </aside>

      <div class="lg:col-span-7 lg:order-1">
        <figure class="mb-12">
          <Picture
            src={d.image}
            alt={d.imageAlt}
            formats={["avif", "webp"]}
            widths={[480, 720, 1024]}
            sizes="(min-width: 1024px) 700px, 100vw"
            loading="eager"
            fetchpriority="high"
            class="aspect-[16/9] w-full rounded-2xl object-cover"
          />
          <figcaption class="mt-3 text-sm text-muted">Illustrative photo. Client details are under NDA.</figcaption>
        </figure>
        <article class="prose-site text-stone-700 [&>h2:first-child]:mt-0">
          <Content />
        </article>

        <h2 class="mt-16 text-h3 text-teal-950">Architecture</h2>
        <div class="mt-6"><ArchitectureDiagram layers={d.architecture} /></div>
        <!-- TODO: confirm the architecture diagram reflects the real system (simplified is fine). -->

        <h2 class="mt-16 text-h3 text-teal-950">Results</h2>
        {d.results ? (
          <dl class="mt-6 grid gap-4 sm:grid-cols-3">
            {d.results.map((r) => (
              <div class="card-tint p-6">
                <dt class="text-sm text-muted">{r.label}</dt>
                <dd class="mt-1 font-display text-h2 text-teal-950">{r.value}</dd>
              </div>
            ))}
          </dl>
        ) : (
          <>
            <!-- TODO: real results — add client-approved metrics to the `results` field of this case study. -->
            <p class="mt-4 max-w-[65ch] text-stone-700">
              Outcome details for this engagement are shared under NDA. We're happy to walk through results and put you in touch with a reference on a call.
            </p>
          </>
        )}

        <h2 class="mt-16 text-h3 text-teal-950">Stack</h2>
        <ul class="mt-5 flex flex-wrap gap-2.5">
          {d.stack.map((t) => <li class="chip text-sm">{t}</li>)}
        </ul>

        <nav aria-label="Next case study" class="mt-16 border-t border-line pt-8">
          <a href={href(`/work/${next.id}/`)} class="group inline-flex flex-col gap-1">
            <span class="text-sm text-muted">Next case study</span>
            <span class="inline-flex items-center gap-2 font-display text-h4 text-teal-950 group-hover:text-teal-900">
              {next.data.title} <Icon name="arrow-right" size={20} class="transition-transform duration-300 group-hover:translate-x-1" />
            </span>
          </a>
        </nav>
      </div>
    </div>
  </section>

  <CtaBand title="Facing something similar?" />
</BaseLayout>
