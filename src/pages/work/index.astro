---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import CaseCard from "../../components/CaseCard.astro";
import CtaBand from "../../components/CtaBand.astro";

const work = (await getCollection("work")).sort((a, b) => a.data.order - b.data.order);
const crumbs = [{ name: "Work", path: "/work/" }];
---
<BaseLayout
  title="Work"
  description="Selected case studies: mobile, AI, cloud modernization and real-time platforms for companies in the UK, India and worldwide. Clients are under NDA."
  breadcrumbs={crumbs}
>
  <PageHero
    breadcrumbs={crumbs}
    eyebrow="Selected work"
    title="Problems we've been"
    accent="trusted with."
    lead="Most of our clients are under NDA, so we describe the work without naming them. We share specifics, architecture and references on a call."
  />
  <section class="section" aria-label="Case studies">
    <div class="container-site">
      <ul class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
        {work.map((item, i) => (
          <li class:list={[{ "lg:col-span-2": i === 0 || i === 3 }]} data-reveal style={`--reveal-delay:${(i % 2) * 80}ms`}>
            <CaseCard item={item} featured={i === 0 || i === 3} headingLevel="h2" />
          </li>
        ))}
      </ul>
      <!-- TODO: add more case studies as they are cleared for publication (src/content/work). -->
    </div>
  </section>
  <CtaBand title="Want the details behind these?" text="We walk through architecture, team shape and references on a call, under NDA if you need one. A senior engineer replies within one business day." />
</BaseLayout>
