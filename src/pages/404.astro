---
import BaseLayout from "../layouts/BaseLayout.astro";
import ClayMark from "../components/ClayMark.astro";
import Icon from "../components/Icon.astro";
import { href } from "../lib/url";

const links = [
  { label: "Home", href: "/" },
  { label: "Services", href: "/services/" },
  { label: "Work", href: "/work/" },
  { label: "Insights", href: "/blog/" },
];
---
<BaseLayout title="Page not found" description="The page you were looking for doesn't exist or has moved." noindex>
  <section class="container-site pt-3 sm:pt-5">
    <div class="panel theme-teal grid gap-8 overflow-hidden lg:grid-cols-12 lg:items-center">
      <div class="lg:col-span-7">
        <p class="eyebrow-pill">Error 404</p>
        <h1 class="mt-6 text-h1">This page doesn't exist, <span class="text-accent">or it has moved.</span></h1>
        <p class="mt-6 max-w-xl text-lead text-stone-700">Links from the old winapps.co.in site redirect automatically. If this one didn't, pick up from here:</p>
        <ul class="mt-8 flex flex-wrap gap-2">
          {links.map((l) => <li><a href={href(l.href)} class="btn btn-light">{l.label}</a></li>)}
          <li><a href={href("/contact/")} class="btn btn-dark">Contact us <Icon name="arrow-right" size={18} class="icon-arrow" /></a></li>
        </ul>
      </div>
      <div class="lg:col-span-5">
        <ClayMark size={384} eager class="mx-auto block w-56 sm:w-72 lg:w-full lg:max-w-sm" />
      </div>
    </div>
  </section>
  <div class="h-16 sm:h-24" aria-hidden="true"></div>
</BaseLayout>
