---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import SectionHeader from "../components/SectionHeader.astro";
import ProcessTimeline from "../components/ProcessTimeline.astro";
import EngagementModels from "../components/EngagementModels.astro";
import TrustSection from "../components/TrustSection.astro";
import FaqList from "../components/FaqList.astro";
import CtaBand from "../components/CtaBand.astro";
import { faqPage } from "../lib/schema";

const faq = (await getCollection("faq")).sort((a, b) => a.data.order - b.data.order).map((f) => f.data);
const crumbs = [{ name: "How we work", path: "/how-we-work/" }];

const principles = [
  { title: "Senior by default", text: "Every engagement is led by an engineer with 8+ years of experience. No bait-and-switch after the sales call." },
  { title: "Written communication", text: "Decisions, trade-offs and status are written down. Async-first, so time zones help rather than hurt." },
  { title: "Security as a baseline", text: "Least-privilege access, client-managed credentials, encrypted devices and offboarding checklists on every project." },
];
---
<BaseLayout
  title="How we work"
  description="Discovery, two-week build sprints and launch: how Winapps delivers, the engagement models we offer, and our commitments on IP, GDPR and security."
  breadcrumbs={crumbs}
  jsonLd={[faqPage(faq)]}
>
  <PageHero
    breadcrumbs={crumbs}
    eyebrow="How we work"
    title="Low-risk to start."
    accent="Predictable to scale."
    lead="A fixed-fee Discovery, working software every two weeks, and a clean handover whenever you want one. Here is exactly how an engagement runs."
  />

  <section class="section" aria-labelledby="process-title">
    <div class="container-site">
      <SectionHeader id="process-title" eyebrow="Process" title="Three phases," accent="no surprises." />
      <div class="mt-14 lg:mt-20"><ProcessTimeline detailed /></div>
    </div>
  </section>

  <section class="pb-[clamp(3.5rem,2.5rem+3.5vw,6rem)]" aria-labelledby="principles-title">
    <div class="container-site">
      <div class="panel theme-stone grid gap-10 lg:grid-cols-12">
        <SectionHeader id="principles-title" eyebrow="Principles" title="How our" accent="engineers work." class="lg:col-span-4" />
        <dl class="grid gap-2 sm:grid-cols-3 lg:col-span-8">
          {principles.map((p, i) => (
            <div class="tile p-6" data-reveal style={`--reveal-delay:${i * 70}ms`}>
              <dt class="font-display text-h4 text-teal-950">{p.title}</dt>
              <dd class="mt-2 text-sm text-stone-700">{p.text}</dd>
            </div>
          ))}
        </dl>
        <!-- TODO: confirm "8+ years" is true for every engagement lead. -->
      </div>
    </div>
  </section>

  <TrustSection />

  <section class="section pt-0" aria-labelledby="engage-title">
    <div class="container-site">
      <SectionHeader id="engage-title" eyebrow="Engagement models" title="Pick how we" accent="work together." intro="Clear terms, no lock-in. Most clients start with Discovery and move to a pod." />
      <div class="mt-12 lg:mt-16"><EngagementModels /></div>
    </div>
  </section>

  <section class="pb-[clamp(3.5rem,2.5rem+3.5vw,6rem)]" aria-labelledby="hww-faq-title">
    <div class="container-site">
      <div class="panel theme-stone grid gap-10 lg:grid-cols-12">
        <div class="lg:col-span-4">
          <SectionHeader id="hww-faq-title" eyebrow="Questions" title="Contracts, IP" accent="and logistics." />
        </div>
        <div class="lg:col-span-7 lg:col-start-6"><FaqList items={faq} /></div>
      </div>
    </div>
  </section>

  <CtaBand />
</BaseLayout>
