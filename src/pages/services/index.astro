---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import Icon from "../../components/Icon.astro";
import CtaBand from "../../components/CtaBand.astro";
import type { IconName } from "../../lib/icons";
import { href } from "../../lib/url";

const services = (await getCollection("services")).sort((a, b) => a.data.order - b.data.order);
const crumbs = [{ name: "Services", path: "/services/" }];
---
<BaseLayout
  title="Services"
  description="AI & machine learning, product engineering, cloud & platform, legacy modernization, data & analytics and dedicated teams, delivered by senior engineers."
  breadcrumbs={crumbs}
>
  <PageHero
    breadcrumbs={crumbs}
    eyebrow="Services"
    title="Six practices, one standard of engineering."
    lead="We stay narrow on purpose. Each practice is run by people who have shipped it in production, more than once, and every engagement comes with the same commitments on IP, security and time-zone overlap."
  />

  <section class="section bg-white" aria-label="All services">
    <div class="container-site">
      <ol class="divide-y divide-line border-y border-line">
        {services.map((s, i) => (
          <li class="group relative grid gap-6 py-10 lg:grid-cols-12 lg:gap-8 lg:py-12" data-reveal>
            <div class="flex items-start gap-5 lg:col-span-5">
              <span class="grid h-12 w-12 shrink-0 place-items-center rounded-xl bg-teal-50 text-teal-700 transition-colors group-hover:bg-teal-700 group-hover:text-white">
                <Icon name={s.data.icon as IconName} size={24} />
              </span>
              <div>
                <p class="text-xs font-semibold tracking-[0.08em] text-muted">0{i + 1}</p>
                <h2 class="mt-1 text-h3 font-semibold tracking-tight text-teal-800">
                  <a href={href(`/services/${s.id}/`)} class="after:absolute after:inset-0">{s.data.title}</a>
                </h2>
                <p class="mt-3 text-stone-700">{s.data.summary}</p>
              </div>
            </div>
            <div class="lg:col-span-6 lg:col-start-7">
              <p class="text-xs font-semibold uppercase tracking-[0.08em] text-teal-700">What you get</p>
              <p class="mt-2 font-display text-h4 font-medium text-ink">{s.data.outcome}</p>
              <p class="mt-5 inline-flex items-center gap-1.5 text-sm font-semibold text-teal-700" aria-hidden="true">
                Explore the practice <Icon name="arrow-right" size={16} class="transition-transform duration-300 group-hover:translate-x-1" />
              </p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <CtaBand edgeClass="text-white" />
</BaseLayout>
