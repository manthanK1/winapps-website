---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import Icon from "../../components/Icon.astro";
import CtaBand from "../../components/CtaBand.astro";
import type { IconName } from "../../lib/icons";
import { href } from "../../lib/url";

const services = (await getCollection("services")).sort((a, b) => a.data.order - b.data.order);
const crumbs = [{ name: "Services", path: "/services/" }];
const themes = ["teal", "orange", "amber", "stone"] as const;
---
<BaseLayout
  title="Services"
  description="AI & machine learning, product engineering, cloud & platform, legacy modernization, data & analytics and dedicated teams, delivered by senior engineers."
  breadcrumbs={crumbs}
>
  <PageHero
    breadcrumbs={crumbs}
    eyebrow="Services"
    title="Six practices,"
    accent="one standard of engineering."
    lead="We stay narrow on purpose. Each practice is run by people who have shipped it in production, more than once, and every engagement comes with the same commitments on IP, security and time-zone overlap."
  />

  <section class="section" aria-label="All services">
    <div class="container-site">
      <ol class="grid gap-4 md:grid-cols-2">
        {services.map((s, i) => (
          <li class={`theme-${themes[i % themes.length]}`} data-reveal style={`--reveal-delay:${(i % 2) * 80}ms`}>
            <article class="card-interactive group relative flex h-full flex-col rounded-[1.5rem] bg-[var(--theme-bg)] p-6 text-[var(--theme-ink)] sm:p-10">
              <Icon name="arrow-up-right" size={20} class="corner-arrow" />
              <div class="flex items-center gap-4">
                <span class="badge-square"><Icon name={s.data.icon as IconName} size={22} /></span>
                <p class="eyebrow">0{i + 1}</p>
              </div>
              <h2 class="mt-6 text-[clamp(1.75rem,1.4rem+1.1vw,2.5rem)] leading-[1.05] tracking-[-0.03em]">
                <a href={href(`/services/${s.id}/`)} class="after:absolute after:inset-0 after:rounded-[inherit] focus-visible:outline-none">
                  {s.data.title}<br /> <span class="text-accent">{s.data.tagline}</span>
                </a>
              </h2>
              <p class="mt-5 text-stone-700">{s.data.summary}</p>
              <div class="mt-auto pt-8">
                <div class="rounded-[1.125rem] bg-white p-5">
                  <p class="eyebrow">What you get</p>
                  <p class="mt-2 font-display text-h4 text-ink">{s.data.outcome}</p>
                </div>
                <p class="line-link mt-5" aria-hidden="true"><span>Explore the practice</span> <Icon name="arrow-right" size={18} /></p>
              </div>
            </article>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <CtaBand />
</BaseLayout>

<style>
  article:has(a:focus-visible) { outline: 3px solid var(--color-teal-600); outline-offset: 3px; }
</style>
