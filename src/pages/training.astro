---
// All training courses, grouped by track (src/content/training.yaml). No
// fees or batch dates yet, so every course enquires on WhatsApp.
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import Icon from "../components/Icon.astro";
import TechLogos from "../components/TechLogos.astro";
import { SITE, whatsappFor } from "../lib/site";
import { courseList } from "../lib/schema";

const tracks = (await getCollection("training")).sort((a, b) => a.data.order - b.data.order);
const courses = tracks.flatMap((t) => t.data.courses);
const crumbs = [{ name: "Training", path: "/training/" }];
const themes = ["teal", "orange", "amber", "stone"] as const;
---
<BaseLayout
  title="Training"
  description={`Hands-on training in ${courses.length} courses: AI & ML, Python, MERN, Java, .NET, PHP, Flutter, iOS & Android, Unity, cloud, AWS DevOps, QA testing and digital marketing.`}
  breadcrumbs={crumbs}
  jsonLd={[courseList(Astro.site, courses)]}
>
  <PageHero
    breadcrumbs={crumbs}
    eyebrow="Training"
    title="Practical training"
    accent="in the skills teams hire for."
    lead={`${courses.length} courses in ${tracks.length} tracks, from Python and AI to cloud, mobile apps, testing and digital marketing. Pick a course and message us on WhatsApp for the next batch, timings and fees.`}
  >
    <div class="mt-8 flex flex-wrap gap-3">
      <a href={whatsappFor("Hi, I'd like to know about your training courses.")} rel="noopener" class="btn btn-whatsapp">
        <Icon name="whatsapp" size={20} class="brand-whatsapp" /> Ask on WhatsApp
      </a>
      <a href={SITE.phoneHref} class="btn btn-light"><Icon name="phone" size={18} /> {SITE.phone}</a>
    </div>
    <nav aria-label="Training tracks" class="mt-8">
      <ul class="flex flex-wrap gap-2">
        {tracks.map((t) => <li><a href={`#${t.id}`} class="btn btn-light btn-sm">{t.data.name}</a></li>)}
      </ul>
    </nav>
  </PageHero>

  {tracks.map((t, i) => (
    <section id={t.id} class:list={["section-tight", `theme-${themes[i % themes.length]}`]} aria-labelledby={`${t.id}-title`}>
      <div class="container-site">
        <div class="max-w-2xl" data-reveal>
          <p class="eyebrow">Track 0{i + 1}</p>
          <h2 id={`${t.id}-title`} class="mt-3 text-h2 text-teal-950">{t.data.name}</h2>
          <p class="mt-4 text-lead text-stone-700">{t.data.intro}</p>
        </div>
        <ul class="mt-8 grid gap-4 md:grid-cols-2">
          {t.data.courses.map((c, j) => (
            <li data-reveal style={`--reveal-delay:${(j % 2) * 80}ms`}>
              <article id={c.id} class="flex h-full flex-col rounded-[1.5rem] bg-[var(--theme-bg)] p-6 text-[var(--theme-ink)] sm:p-8" aria-labelledby={`${c.id}-title`}>
                <TechLogos logos={c.logos} />
                <h3 id={`${c.id}-title`} class="mt-6 text-h3">{c.name}</h3>
                <p class="mt-2 text-stone-700">{c.summary}</p>
                <div class="mt-6 rounded-[1.125rem] bg-white p-5">
                  <p class="eyebrow">What you'll learn</p>
                  <ul class="mt-3 grid gap-2 text-sm text-stone-800">
                    {c.topics.map((topic) => (
                      <li class="flex gap-2"><Icon name="check" size={18} class="mt-0.5 flex-none text-[var(--theme-accent)]" />{topic}</li>
                    ))}
                  </ul>
                </div>
                <div class="mt-auto pt-6">
                  <a
                    href={whatsappFor(`Hi, I'm interested in the ${c.name} training. Could you share the next batch, timings and fees?`)}
                    rel="noopener"
                    class="btn btn-whatsapp"
                  >
                    <Icon name="whatsapp" size={20} class="brand-whatsapp" /><span>Enquire<span class="sr-only"> about {c.name}</span> on WhatsApp</span>
                  </a>
                </div>
              </article>
            </li>
          ))}
        </ul>
      </div>
    </section>
  ))}

  <section class="section defer-render pb-4 text-center sm:pb-6" aria-labelledby="training-cta-title">
    <div class="container-site" data-reveal>
      <h2 id="training-cta-title" class="mx-auto max-w-3xl text-h2 text-teal-950">Not sure which course fits?</h2>
      <p class="mx-auto mt-5 max-w-xl text-lead text-stone-700">Tell us what you know today and where you want to get to. We'll suggest a starting point and share batch dates, timings and fees.</p>
      <div class="mt-8 flex flex-col items-center justify-center gap-3 xs:flex-row">
        <a href={whatsappFor("Hi, I'd like help choosing a training course.")} rel="noopener" class="btn btn-whatsapp">
          <Icon name="whatsapp" size={20} class="brand-whatsapp" /> Ask on WhatsApp
        </a>
        <a href={SITE.phoneHref} class="btn btn-outline"><Icon name="phone" size={18} /> {SITE.phone}</a>
      </div>
    </div>
  </section>
</BaseLayout>
