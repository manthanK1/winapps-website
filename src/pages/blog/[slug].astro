---
// Blog guide: meta → contents → article → FAQ → "talk it through" → more guides.
// Slugs match the live site, so old /blog/<slug> links keep working.
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import PostCard from "../../components/PostCard.astro";
import FaqList from "../../components/FaqList.astro";
import SectionHeader from "../../components/SectionHeader.astro";
import Icon from "../../components/Icon.astro";
import CtaBand from "../../components/CtaBand.astro";
import { article, faqPage } from "../../lib/schema";
import { contactFor } from "../../lib/site";
import { href } from "../../lib/url";

export async function getStaticPaths() {
  const posts = (await getCollection("blog")).sort((a, b) => b.data.updated.valueOf() - a.data.updated.valueOf());
  return posts.map((entry) => ({
    params: { slug: entry.id },
    props: { entry, more: posts.filter((p) => p.id !== entry.id).slice(0, 3) },
  }));
}

const { entry, more } = Astro.props;
const d = entry.data;
const { Content, headings } = await render(entry);
const toc = headings.filter((h) => h.depth === 2);
// The practice this guide belongs to (services list their guides in relatedPosts).
const service = (await getCollection("services")).find((s) => s.data.relatedPosts.some((p) => p.id === entry.id));
const path = `/blog/${entry.id}/`;
const crumbs = [{ name: "Blog", path: "/blog/" }, { name: d.title, path }];
const updated = d.updated.toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric", timeZone: "UTC" });
const schemas: object[] = [article(Astro.site, { type: "BlogPosting", headline: d.title, description: d.description, path, date: d.updated, author: d.author })];
if (d.faq.length) schemas.push(faqPage(d.faq));
---
<BaseLayout title={d.title} description={d.description} breadcrumbs={crumbs} jsonLd={schemas}>
  <PageHero breadcrumbs={crumbs} eyebrow="Guide" title={d.title}>
    <p class="mt-8 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-stone-700">
      <span>Updated <time datetime={d.updated.toISOString().slice(0, 10)}>{updated}</time></span>
      <span aria-hidden="true">·</span>
      <span>{d.readMinutes} min read</span>
      <span aria-hidden="true">·</span>
      <span>By {d.author}</span>
    </p>
  </PageHero>

  <section class="section" aria-label="Article">
    <div class="container-site grid gap-10 lg:grid-cols-12">
      <nav aria-labelledby="toc-title" class="lg:col-span-3">
        <div class="card-tint p-5 lg:sticky lg:top-24">
          <h2 id="toc-title" class="eyebrow">Contents</h2>
          <ol class="mt-3 space-y-0.5 text-sm">
            {toc.map((h) => <li><a class="pop flex min-h-9 items-center rounded-lg px-2 text-stone-700 hover:text-ink [--pop-inset:0]" href={`#${h.slug}`}>{h.text}</a></li>)}
            {d.faq.length > 0 && <li><a class="pop flex min-h-9 items-center rounded-lg px-2 text-stone-700 hover:text-ink [--pop-inset:0]" href="#faq-title">Frequently asked questions</a></li>}
          </ol>
        </div>
      </nav>

      <div class="min-w-0 lg:col-span-8 lg:col-start-5">
        <article class="prose-site max-w-none text-stone-700">
          <Content />
        </article>

        {d.faq.length > 0 && (
          <section class="mt-16" aria-labelledby="faq-title">
            <h2 id="faq-title" class="text-h3 text-teal-950">Frequently asked questions</h2>
            <div class="mt-6"><FaqList items={d.faq} /></div>
          </section>
        )}

        <aside class="panel theme-orange mt-16" aria-labelledby="talk-title">
          <h2 id="talk-title" class="text-h2">Planning a build like this? <span class="text-accent">Get a number you can use.</span></h2>
          <p class="mt-4 max-w-xl text-stone-700">These ranges are a starting point. A fixed-fee Discovery gives you a plan and estimate for your scope, which you own whoever builds it.</p>
          <div class="mt-6 flex flex-wrap gap-2">
            <a class="btn btn-theme" href={href(service ? contactFor(service.id) : "/contact/")}>Book a 30-min intro call <Icon name="arrow-right" size={18} class="icon-arrow" /></a>
            {service && <a class="btn btn-light" href={href(`/services/${service.id}/`)}>{service.data.title}</a>}
          </div>
        </aside>
      </div>
    </div>
  </section>

  {more.length > 0 && (
    <section class="pb-[clamp(3.5rem,2.5rem+3.5vw,6rem)]" aria-labelledby="more-title">
      <div class="container-site">
        <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
          <SectionHeader id="more-title" eyebrow="Keep reading" title="More guides" />
          <a href={href("/blog/")} class="line-link shrink-0"><span>All insights</span> <Icon name="arrow-right" size={18} /></a>
        </div>
        <ul class="mt-10 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
          {more.map((p, i) => <li><PostCard post={p} tone={(["teal", "amber", "stone"] as const)[i % 3]} /></li>)}
        </ul>
      </div>
    </section>
  )}

  <CtaBand />
</BaseLayout>

<script>
  // Put each cost table in a keyboard-scrollable box named after its section,
  // so wide tables scroll sideways on phones instead of squeezing.
  for (const table of document.querySelectorAll<HTMLTableElement>(".prose-site table")) {
    let heading = table.previousElementSibling;
    while (heading && !/^H[23]$/.test(heading.tagName)) heading = heading.previousElementSibling;
    const wrap = document.createElement("div");
    wrap.className = "table-wrap";
    wrap.tabIndex = 0;
    wrap.setAttribute("role", "region");
    wrap.setAttribute("aria-label", heading?.textContent ? `Table: ${heading.textContent}` : "Table");
    table.before(wrap);
    wrap.append(table);
  }
</script>
